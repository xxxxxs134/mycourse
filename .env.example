# ---- 数据库 (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mycourse
DB_PASSWORD=your_password
DB_NAME=mycourse

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- 管理员登录 (后端 JWT 鉴权) ----
ADMIN_USER=admin
ADMIN_PASS=change_me
JWT_SECRET=please_generate_a_random_secret

# ---- 微信支付 (不配置则自动降级为 Mock 支付) ----
WECHAT_APP_ID=wx_your_appid
WECHAT_MCH_ID=your_mch_id
WECHAT_API_V3_KEY=your_api_v3_key
WECHAT_MCH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
WECHAT_MCH_SERIAL_NO=your_cert_serial_no
WECHAT_PLATFORM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
